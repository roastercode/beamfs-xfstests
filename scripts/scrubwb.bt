#!/usr/bin/env bpftrace
/*
 * What the scrubber reads and writes back, against who owned the block.
 *
 * generic/083, seed 274870549, 2026-09-28: 7 failures in 36 trials
 * with the scrubber at 100 ms, 0 in 8 with it parked. Up to beamfs
 * 0.1.22 every write-back and every "uncorrectable" verdict of the
 * sweep traced (17 of 17) was on a block freed and allocated to
 * another file since the walk began (known-limitations 3.39).
 *
 * beamfs 0.1.23 asks the file that owns a leaf, under its allocation
 * mutex, before it reads the leaf and again before it writes it back,
 * and returns -ESTALE (-116) when the leaf is no longer in that file.
 * check_block takes the owner and the logical block as its fourth and
 * fifth arguments (NULL and 0 from the wear step, which never writes).
 * This keeps, printed as it happens on the two test devices:
 *
 *   SC  every check_block: start, end, thread, device, block,
 *       subblocks corrected, return code, owner inode, logical block;
 *   WB  every write-back: mark_buffer_dirty on the checked block,
 *       from inside check_block;
 *   CR  every confirming read of the medium (submit_bio_wait from
 *       inside check_block);
 *   SW  every indirect block a walk verifies;
 *   AL, FR  every allocation and free, with the inode;
 *   TS  every pointer stored into an indirect block (beamfs_tc_store).
 *
 * scripts/scrubwb.py says, for every block the scrubber decoded and
 * every block it wrote, whether another inode held it at that moment.
 *
 * BX_TEST_DEV and BX_SCRATCH_DEV are put in by beamfs-xfstests.
 */

BEGIN
{
    printf("scrub reads and write-backs against block ownership, v3\n");
    printf("devs test %u scratch %u\n", BX_TEST_DEV, BX_SCRATCH_DEV);
}

kprobe:beamfs_scrub_check_block
{
    $sb = (struct super_block *)arg0;
    if ($sb->s_dev == BX_TEST_DEV || $sb->s_dev == BX_SCRATCH_DEV) {
        @sc_dev[tid] = $sb->s_dev;
        @sc_phys[tid] = arg1;
        @sc_corr[tid] = arg2;
        @sc_ns[tid] = nsecs;
        @sc_ib[tid] = arg4;
        if (arg3 != 0) {
            @sc_ino[tid] = ((struct inode *)arg3)->i_ino;
        } else {
            @sc_ino[tid] = 0;
        }
    }
}

/*
 * Inside a check, the checked block dirtied is the write-back; other
 * buffers dirtied there (the RS journal, the budget) are not.
 */
kprobe:mark_buffer_dirty /@sc_dev[tid]/
{
    $bh = (struct buffer_head *)arg0;
    if ($bh->b_blocknr == @sc_phys[tid]) {
        printf("WB %llu %d %u %llu\n", nsecs, tid, @sc_dev[tid],
               $bh->b_blocknr);
    }
}

kprobe:submit_bio_wait /@sc_dev[tid]/
{
    printf("CR %llu %d %u %llu\n", nsecs, tid, @sc_dev[tid], @sc_phys[tid]);
}

kretprobe:beamfs_scrub_check_block /@sc_dev[tid]/
{
    $c = *(uint32 *)@sc_corr[tid];
    $rc = (int32)retval;
    @checks = count();
    printf("SC %llu %llu %d %u %llu %u %d %llu %llu\n", @sc_ns[tid], nsecs,
           tid, @sc_dev[tid], @sc_phys[tid], $c, $rc, @sc_ino[tid],
           @sc_ib[tid]);
    delete(@sc_dev[tid]);
    delete(@sc_phys[tid]);
    delete(@sc_corr[tid]);
    delete(@sc_ns[tid]);
    delete(@sc_ib[tid]);
    delete(@sc_ino[tid]);
}

/*
 * An indirect block the walk verifies. beamfs_scrub_walk_level is
 * static and not traceable; it verifies each indirect block it walks,
 * after asking the owner whether the block is still its own.
 */
kprobe:beamfs_ind_parity_verify_medium
{
    $sb = (struct super_block *)arg0;
    $bh = (struct buffer_head *)arg1;
    if ($sb->s_dev == BX_TEST_DEV || $sb->s_dev == BX_SCRATCH_DEV) {
        printf("SW %llu %d %u %llu 1\n", nsecs, tid, $sb->s_dev,
               $bh->b_blocknr);
    }
}

tracepoint:beamfs:beamfs_block_alloc
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    printf("AL %llu %u %llu %llu %d\n", nsecs, args.dev, args.blk,
           args.ino, args.level);
}

tracepoint:beamfs:beamfs_block_free
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    printf("FR %llu %u %llu %llu\n", nsecs, args.dev, args.blk, args.ino);
}

kprobe:beamfs_tc_store
{
    $sb = (struct super_block *)arg0;
    if ($sb->s_dev == BX_TEST_DEV || $sb->s_dev == BX_SCRATCH_DEV) {
        printf("TS %llu %u %llu %u %llu %llu %llu\n", nsecs, $sb->s_dev,
               arg2, (uint32)arg3, arg4, arg5, arg1);
    }
}

END
{
    clear(@sc_dev);
    clear(@sc_phys);
    clear(@sc_corr);
    clear(@sc_ns);
    clear(@sc_ib);
    clear(@sc_ino);
    printf("end\n");
}
