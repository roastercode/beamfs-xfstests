#!/usr/bin/env bpftrace
/*
 * A block allocated, placed in the tree, and never written.
 *
 * generic/013 ends with 32 such blocks in four runs, the longest of
 * fifteen, all belonging to one inode -- and the kernel says nothing:
 * no lost pointer, no uncorrectable subblock, no failed encode. The
 * allocation succeeded, the slot took the pointer, and the data never
 * arrived.
 *
 * Fifteen consecutive blocks is one write's worth. So: which blocks
 * are allocated, which are sealed, and what is in the difference.
 */

/*
 * The node's own root is beamfs. Without a filter this script counts
 * the rootfs's allocations alongside the test's: one run reported 2796
 * allocations on a volume of 262144 blocks, 62 of the 64 blocks still
 * live at the end belonging to inode 27192 of /dev/vda, and the
 * conclusions drawn from it were about the wrong filesystem.
 *
 * BX_TEST_DEV and BX_SCRATCH_DEV are replaced by beamfs-xfstests with
 * the dev_t of this node's two volumes.
 */
BEGIN { printf("allocated, placed, and never sealed\n"); }

tracepoint:beamfs:beamfs_block_alloc
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @allocs = count();
    @live[args.dev, args.blk] = args.ino;
}

/*
 * Sealing is what puts bytes and parity into a data block. A block
 * that is never sealed is one nothing ever wrote.
 */
kprobe:beamfs_seal_data_block
/((struct super_block *)arg0)->s_dev == BX_TEST_DEV ||
 ((struct super_block *)arg0)->s_dev == BX_SCRATCH_DEV/
{
    @seals = count();
}

kretprobe:beamfs_seal_data_block
{
    @sealed_ok = count();
}

tracepoint:beamfs:beamfs_block_free
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @frees = count();
    if (@live[args.dev, args.blk]) {
        delete(@live[args.dev, args.blk]);
    }
}

/*
 * Writeback: how many blocks a single writeback_range covers, and how
 * many it seals. If a range maps fifteen blocks and seals one, that is
 * the shape of the leak.
 */
kprobe:beamfs_inline_writeback_range { @wb_calls = count(); }

END
{
    printf("\nstill live at the end, by inode:\n");
    print(@live, 40);
}
