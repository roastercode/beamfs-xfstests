#!/usr/bin/env bpftrace
/*
 * Where the time goes when the disk is not the limit.
 *
 * generic/074 on 2026-09-23, module 0.1.8: bios of 128-256 KiB, the
 * device 43 % busy with three requests in flight, and the test
 * progressing no faster than when every write was one block. What
 * remains is CPU, or waiting on a lock.
 *
 * Two views. On-CPU: the kernel stack of whatever is running, sampled
 * at 99 Hz on every CPU; a sample landing in swapper is idle, so the
 * per-command count also says how much of the machine was used at
 * all. Off-CPU: for every switch away from a task in uninterruptible
 * sleep, the stack it slept in and how long it stayed away, summed by
 * stack. Filesystem functions in the first view are the encoders and
 * decoders; in the second, the locks.
 */

BEGIN { printf("sampling on-CPU stacks at 99 Hz and off-CPU time in D\n"); }

profile:hz:99
{
    @oncpu_by_comm[comm] = count();
    if (comm != "swapper/0" && comm != "swapper/1" &&
        comm != "swapper/2" && comm != "swapper/3" &&
        comm != "swapper/4" && comm != "swapper/5" &&
        comm != "swapper/6" && comm != "swapper/7") {
        @oncpu_kernel[kstack(8)] = count();
    }
}

/* TASK_UNINTERRUPTIBLE is bit 1 of prev_state; TASK_KILLABLE sets it too. */
tracepoint:sched:sched_switch
/(args.prev_state & 2) != 0/
{
    @blocked_at[args.prev_pid] = nsecs;
    @blocked_in[args.prev_pid] = kstack(10);
}

tracepoint:sched:sched_switch
/@blocked_at[args.next_pid] != 0/
{
    @offcpu_ns_by_stack[@blocked_in[args.next_pid]] =
        sum(nsecs - @blocked_at[args.next_pid]);
    @offcpu_ns_by_comm[args.next_comm] =
        sum(nsecs - @blocked_at[args.next_pid]);
    delete(@blocked_at[args.next_pid]);
    delete(@blocked_in[args.next_pid]);
}

END
{
    clear(@blocked_at);
    clear(@blocked_in);
    printf("\n");
}
