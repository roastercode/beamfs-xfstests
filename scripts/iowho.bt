#!/usr/bin/env bpftrace
/*
 * Who writes, and how much.
 *
 * generic/074 on 2026-09-22: fstest wrote 220 MiB of file data, and
 * /dev/vdb received 9 121 MiB in 1.88 million requests averaging one
 * block -- forty-one bytes on the medium for one asked, at 4.9 MB/s.
 * The diskstats had said so in every runpack; nothing had named the
 * writers.
 *
 * This does: every bio submitted for the test or scratch device, by
 * the kernel stack that submitted it, with the bytes it carried, and
 * by the zone of the volume it hit. The zones are those of the 1 GiB
 * volume mkfs.beamfs -N 16384 lays out (inode table from block 1,
 * bitmap 1025..1032, parity and budget regions up to the canary at
 * 18442, data from 18443); on another layout the zone lines are
 * wrong and the stacks are still right.
 *
 * Reads are counted the same way, with shorter stacks: the question
 * is the writes.
 */

BEGIN { printf("watching submit_bio for the test and scratch devices\n"); }

kprobe:submit_bio
{
    $bio = (struct bio *)arg0;
    $dev = $bio->bi_bdev->bd_dev;

    if ($dev == BX_TEST_DEV || $dev == BX_SCRATCH_DEV) {
        /* REQ_OP_BITS is 8: the low byte of bi_opf is the operation,
         * REQ_OP_READ 0 and REQ_OP_WRITE 1. */
        $op    = $bio->bi_opf & 0xff;
        $bytes = $bio->bi_iter.bi_size;
        $blk   = $bio->bi_iter.bi_sector / 8;

        if ($op == 1) {
            @wr_ios   = count();
            @wr_bytes = sum($bytes);
            @wr_size  = hist($bytes);
            @wr_bytes_by_stack[kstack(10)] = sum($bytes);
            @wr_ios_by_stack[kstack(10)]   = count();
            @wr_bytes_by_comm[comm]        = sum($bytes);

            if ($blk < 1025) {
                @wr_bytes_by_zone["inode table"] = sum($bytes);
                @wr_ios_by_zone["inode table"]   = count();
            }
            if ($blk >= 1025 && $blk < 1033) {
                @wr_bytes_by_zone["bitmap"] = sum($bytes);
                @wr_ios_by_zone["bitmap"]   = count();
            }
            if ($blk >= 1033 && $blk < 18443) {
                @wr_bytes_by_zone["parity and budget regions"] = sum($bytes);
                @wr_ios_by_zone["parity and budget regions"]   = count();
            }
            if ($blk >= 18443) {
                @wr_bytes_by_zone["data"] = sum($bytes);
                @wr_ios_by_zone["data"]   = count();
            }
        }
        if ($op == 0) {
            @rd_ios   = count();
            @rd_bytes = sum($bytes);
            @rd_bytes_by_stack[kstack(6)] = sum($bytes);
        }
    }
}

/* What the filesystem was asked to do meanwhile, on the same volumes,
 * so the bytes above can be divided by something. */
tracepoint:beamfs:beamfs_block_alloc
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @allocs = count();
}

END { printf("\n"); }
