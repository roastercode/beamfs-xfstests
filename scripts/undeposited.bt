tracepoint:beamfs:beamfs_block_free
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @freed[args.blk] = count();
    @free_ns[args.blk] = nsecs;
    @free_stack[args.blk] = kstack;
}

kprobe:submit_bio
/(((struct bio *)arg0)->bi_bdev->bd_dev == BX_TEST_DEV ||
  ((struct bio *)arg0)->bi_bdev->bd_dev == BX_SCRATCH_DEV) &&
 (((struct bio *)arg0)->bi_opf & 0xff) == 1 &&
 (((struct bio *)arg0)->bi_iter.bi_sector >> 3) < 18443/
{
    $bio = (struct bio *)arg0;
    $blk = $bio->bi_iter.bi_sector >> 3;
    printf("W %llu %llu %u %s\n", nsecs, $blk, $bio->bi_iter.bi_size, kstack(6));
    /*
     * For a region block, whether the page carries anything: 32 words
     * of 64 bits sampled every 128 bytes. A region freshly deposited
     * into is not all zero; the interleave spreads a slot over the
     * block, so the sample sees it.
     */
    if ($blk >= 1033 && $blk < 18443) {
        $bv = $bio->bi_io_vec;
        $frame = ((uint64)$bv->bv_page - *(uint64 *)kaddr("vmemmap_base")) / 64;
        $va = *(uint64 *)kaddr("page_offset_base") + $frame * 4096 + (uint64)$bv->bv_offset;
        $nz = (uint64)0;
        $nz += (*(uint64 *)($va + 0) != 0);    $nz += (*(uint64 *)($va + 128) != 0);  $nz += (*(uint64 *)($va + 256) != 0);  $nz += (*(uint64 *)($va + 384) != 0);
        $nz += (*(uint64 *)($va + 512) != 0);  $nz += (*(uint64 *)($va + 640) != 0);  $nz += (*(uint64 *)($va + 768) != 0);  $nz += (*(uint64 *)($va + 896) != 0);
        $nz += (*(uint64 *)($va + 1024) != 0); $nz += (*(uint64 *)($va + 1152) != 0); $nz += (*(uint64 *)($va + 1280) != 0); $nz += (*(uint64 *)($va + 1408) != 0);
        $nz += (*(uint64 *)($va + 1536) != 0); $nz += (*(uint64 *)($va + 1664) != 0); $nz += (*(uint64 *)($va + 1792) != 0); $nz += (*(uint64 *)($va + 1920) != 0);
        $nz += (*(uint64 *)($va + 2048) != 0); $nz += (*(uint64 *)($va + 2176) != 0); $nz += (*(uint64 *)($va + 2304) != 0); $nz += (*(uint64 *)($va + 2432) != 0);
        $nz += (*(uint64 *)($va + 2560) != 0); $nz += (*(uint64 *)($va + 2688) != 0); $nz += (*(uint64 *)($va + 2816) != 0); $nz += (*(uint64 *)($va + 2944) != 0);
        $nz += (*(uint64 *)($va + 3072) != 0); $nz += (*(uint64 *)($va + 3200) != 0); $nz += (*(uint64 *)($va + 3328) != 0); $nz += (*(uint64 *)($va + 3456) != 0);
        $nz += (*(uint64 *)($va + 3584) != 0); $nz += (*(uint64 *)($va + 3712) != 0); $nz += (*(uint64 *)($va + 3840) != 0); $nz += (*(uint64 *)($va + 3968) != 0);
        printf("Z %llu %llu %d\n", nsecs, $blk, $nz);

    }
}

kprobe:generic_shutdown_super { printf("U %llu unmount\n", nsecs); }
kprobe:beamfs_fill_super { printf("M %llu mount\n", nsecs); }
kprobe:beamfs_put_super { printf("P %llu put_super\n", nsecs); }

END { clear(@in_update); clear(@raw); clear(@before); clear(@after); clear(@encode_failed); clear(@cur_phys); clear(@blksum); printf("end\n"); }
