kretprobe:beamfs_ind_parity_update { delete(@in_update[tid]); delete(@raw[tid]); delete(@before[tid]); delete(@cur_phys[tid]); delete(@blksum[tid]); }

/*
 * The region buffer as the update receives it: the whole page summed,
 * 512 words, to be compared with the same sum after ind_region_write.
 * A deposit that adds a pointer and leaves the page's sum unchanged
 * deposited nothing, whatever the interleave puts where.
 */
