    @blksum[tid] += *(uint64 *)(($q + 1280) + 0) + *(uint64 *)(($q + 1280) + 8) + *(uint64 *)(($q + 1280) + 16) + *(uint64 *)(($q + 1280) + 24) + *(uint64 *)(($q + 1280) + 32) + *(uint64 *)(($q + 1280) + 40) + *(uint64 *)(($q + 1280) + 48) + *(uint64 *)(($q + 1280) + 56);
    @blksum[tid] += *(uint64 *)(($q + 1344) + 0) + *(uint64 *)(($q + 1344) + 8) + *(uint64 *)(($q + 1344) + 16) + *(uint64 *)(($q + 1344) + 24) + *(uint64 *)(($q + 1344) + 32) + *(uint64 *)(($q + 1344) + 40) + *(uint64 *)(($q + 1344) + 48) + *(uint64 *)(($q + 1344) + 56);
    @blksum[tid] += *(uint64 *)(($q + 1408) + 0) + *(uint64 *)(($q + 1408) + 8) + *(uint64 *)(($q + 1408) + 16) + *(uint64 *)(($q + 1408) + 24) + *(uint64 *)(($q + 1408) + 32) + *(uint64 *)(($q + 1408) + 40) + *(uint64 *)(($q + 1408) + 48) + *(uint64 *)(($q + 1408) + 56);
