#!/usr/bin/env bpftrace
/*
 * Allocated as an indirect block, and deposited or never.
 *
 * generic/013 of the sealed sweep of 2026-09-26: seven indirect blocks
 * hold pointers under no parity, and for five of them the whole region
 * block on the medium is zero, 4096 bytes of it. Every earlier reading
 * (parity.bt, the 0.1.19 slot audit) asked whether a slot once
 * deposited was later lost, and found none lost. This one asks the
 * other question: was it ever deposited.
 *
 * Kept per block, each with the time of its last occurrence: each
 * allocation with its level and the stack that asked for it, each
 * pointer stored into it (beamfs_slot_store), each beamfs_parity_slot
 * event, each call of beamfs_ind_parity_update by buffer number, each
 * free. The second capture of generic/013 said the three blocks fsck
 * named had been deposited many times, last with nz=0, then freed,
 * then held pointers again: the order of those events is the finding. bpftrace prints
 * every map at exit; the station joins them with the blocks fsck names
 * on the frozen image (scripts/undeposited.py).
 *
 * Since the fourth reading: every write bio of the metadata zone
 * (blocks below 18443: superblock, bitmaps, inode table, parity
 * regions) printed as it happens with its stack, and mount, unmount
 * and put_super dated. generic/013 checks its test device in the
 * middle of the test: unmount, fsck, copy, remount, then it deletes
 * its files. The copy fsck names blocks on is the state at that
 * unmount, so the question for a named block is whether its region
 * was written between its last deposit and that unmount.
 *
 * BX_TEST_DEV and BX_SCRATCH_DEV are put in by beamfs-xfstests for the
 * node it attaches to: the root filesystem is beamfs too and would
 * otherwise count.
 */

BEGIN { printf("indirect allocations against deposits\n"); }

/*
 * Every allocation on the two devices, whatever its level: on
 * generic/013 the first capture saw 92 blocks deposited and not one
 * allocation at level > 0, so level does not name the indirect
 * blocks, and the join with fsck's list has to be made on all of them.
 * A few thousand entries on this test.
 */
tracepoint:beamfs:beamfs_block_alloc
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @alloc[args.blk] = args.ino;
    @alloc_level[args.blk] = args.level;
    @alloc_stack[args.blk] = kstack;
    @alloc_ns[args.blk] = nsecs;
    @alloc_n[args.blk] = count();
    @allocs = count();
    @allocs_by_level[args.level] = count();
}

/*
 * A pointer installed in an indirect block: the last one, by time,
 * against the last deposit of that block. A store after the last
 * deposit is a block carrying pointers nothing describes.
 */
tracepoint:beamfs:beamfs_slot_store
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @store_ns[args.parent] = nsecs;
    @store_n[args.parent] = count();
    @store_stack[args.parent] = kstack;
    @stores = count();
    /*
     * The index the pointer goes to, printed: a deposit that changes
     * nothing in the region follows a store, and the index says
     * whether the stored pointer lies in the bytes the slot's parity
     * covers.
     */
    printf("T %llu %llu %llu %llu\n", nsecs, args.parent, args.slot, args.new);
}

tracepoint:beamfs:beamfs_parity_slot
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @dep[args.phys] = count();
    @dep_nz[args.phys] = args.nz;
    @dep_region[args.phys] = args.region;
    @dep_ns[args.phys] = nsecs;
    @deps = count();
    printf("S %llu %llu %llu %u %s\n", nsecs, args.phys, args.region, args.nz, kstack(4));
}

/*
 * The deposit as the module calls it, by the buffer's block number:
 * a call that fires no beamfs_parity_slot event is a deposit that
 * returned before filing anything.
 */
kprobe:beamfs_ind_parity_update
/((struct buffer_head *)arg1)->b_bdev->bd_dev == BX_TEST_DEV ||
 ((struct buffer_head *)arg1)->b_bdev->bd_dev == BX_SCRATCH_DEV/
{
    $bh = (struct buffer_head *)arg1;
    @upd[$bh->b_blocknr] = count();
    @upd_stack[$bh->b_blocknr] = kstack;
    @upds = count();
    @in_update[tid] = 1;
    /*
     * The slot's raw offset from the block number, INLINE layout: data
     * from 18443, 14 slots of 256 bytes a region, the region's data
     * view interleaved into codewords of 239 data + 16 parity bytes.
     * Computed here so the buffer can be summed before the update.
     */
    $idx = $bh->b_blocknr - 18443;
    $off = ($idx % 14) * 256;
    @raw[tid] = ($off / 239) * 255 + $off % 239;
    /*
     * The indirect block itself, the encoder's input: its number and
     * the sum of its page, so two deposits of the same block can be
     * told apart by what they were asked to describe.
     */
    @cur_phys[tid] = $bh->b_blocknr;
    $q = (uint8 *)$bh->b_data;
    @blksum[tid] = (uint64)0;
    @blksum[tid] += *(uint64 *)(($q + 0) + 0) + *(uint64 *)(($q + 0) + 8) + *(uint64 *)(($q + 0) + 16) + *(uint64 *)(($q + 0) + 24) + *(uint64 *)(($q + 0) + 32) + *(uint64 *)(($q + 0) + 40) + *(uint64 *)(($q + 0) + 48) + *(uint64 *)(($q + 0) + 56);
    @blksum[tid] += *(uint64 *)(($q + 64) + 0) + *(uint64 *)(($q + 64) + 8) + *(uint64 *)(($q + 64) + 16) + *(uint64 *)(($q + 64) + 24) + *(uint64 *)(($q + 64) + 32) + *(uint64 *)(($q + 64) + 40) + *(uint64 *)(($q + 64) + 48) + *(uint64 *)(($q + 64) + 56);
    @blksum[tid] += *(uint64 *)(($q + 128) + 0) + *(uint64 *)(($q + 128) + 8) + *(uint64 *)(($q + 128) + 16) + *(uint64 *)(($q + 128) + 24) + *(uint64 *)(($q + 128) + 32) + *(uint64 *)(($q + 128) + 40) + *(uint64 *)(($q + 128) + 48) + *(uint64 *)(($q + 128) + 56);
    @blksum[tid] += *(uint64 *)(($q + 192) + 0) + *(uint64 *)(($q + 192) + 8) + *(uint64 *)(($q + 192) + 16) + *(uint64 *)(($q + 192) + 24) + *(uint64 *)(($q + 192) + 32) + *(uint64 *)(($q + 192) + 40) + *(uint64 *)(($q + 192) + 48) + *(uint64 *)(($q + 192) + 56);
    @blksum[tid] += *(uint64 *)(($q + 256) + 0) + *(uint64 *)(($q + 256) + 8) + *(uint64 *)(($q + 256) + 16) + *(uint64 *)(($q + 256) + 24) + *(uint64 *)(($q + 256) + 32) + *(uint64 *)(($q + 256) + 40) + *(uint64 *)(($q + 256) + 48) + *(uint64 *)(($q + 256) + 56);
    @blksum[tid] += *(uint64 *)(($q + 320) + 0) + *(uint64 *)(($q + 320) + 8) + *(uint64 *)(($q + 320) + 16) + *(uint64 *)(($q + 320) + 24) + *(uint64 *)(($q + 320) + 32) + *(uint64 *)(($q + 320) + 40) + *(uint64 *)(($q + 320) + 48) + *(uint64 *)(($q + 320) + 56);
    @blksum[tid] += *(uint64 *)(($q + 384) + 0) + *(uint64 *)(($q + 384) + 8) + *(uint64 *)(($q + 384) + 16) + *(uint64 *)(($q + 384) + 24) + *(uint64 *)(($q + 384) + 32) + *(uint64 *)(($q + 384) + 40) + *(uint64 *)(($q + 384) + 48) + *(uint64 *)(($q + 384) + 56);
    @blksum[tid] += *(uint64 *)(($q + 448) + 0) + *(uint64 *)(($q + 448) + 8) + *(uint64 *)(($q + 448) + 16) + *(uint64 *)(($q + 448) + 24) + *(uint64 *)(($q + 448) + 32) + *(uint64 *)(($q + 448) + 40) + *(uint64 *)(($q + 448) + 48) + *(uint64 *)(($q + 448) + 56);
