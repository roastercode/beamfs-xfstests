/*
 * The encoder's verdict, ignored by the update's slot loop: a failure
 * there leaves slotbuf as gather filled it, the slot as it was, and
 * the region unchanged.
 */
kretprobe:beamfs_rs_encode_region
/@in_update[tid]/
{
    @encode_rc[retval] = count();
    if (retval < 0) { @encode_failed[tid] = 1; }
}

/*
 * The slot's first 16 bytes in the region buffer, right after
 * ind_region_write, as the update marks the buffer dirty. The slot
 * sits at data offset slot * stride in the region's data view; raw
 * offset = (off / 239) * 255 + off % 239, one codeword of 239 data
 * bytes plus 16 parity bytes. A block with a few pointers has one
 * non-zero subblock, so its slot carries 16 non-zero parity bytes at
 * its start and zeros after: sampling misses them, this reads them.
 * The buffer's page is printed too, to be compared with the page the
 * write bio carries.
 */
kprobe:mmb_mark_buffer_dirty
/@in_update[tid]/
{
    $bh = (struct buffer_head *)arg0;
    $p = (uint8 *)$bh->b_data;
    @after[tid] = (uint64)0;
