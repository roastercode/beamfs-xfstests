#!/usr/bin/env bpftrace
/*
 * A metadata block dirtied and never written.
 *
 * generic/269 fills the volume, and leaves 2230 indirect blocks whose
 * pointer is installed and whose contents never reached the medium --
 * fsck reads them as "never described", the subtree under each
 * unreachable -- plus 353 data blocks allocated and never written.
 *
 * Every one of those blocks goes onto an inode's i_metadata_bhs by
 * mmb_mark_buffer_dirty, and comes off it by mmb_sync from write_inode
 * or by mmb_invalidate from evict. The first writes, the second does
 * not.
 *
 * So: which blocks go on, which come off by which path, and what does
 * ENOSPC leave behind.
 */

BEGIN { printf("watching the metadata lists\n"); }

kprobe:mmb_mark_buffer_dirty
{
    /*
     * Counted, not remembered.
     *
     * Keeping a key per block filled bpftrace's map in seconds and
     * the capture became 21 MB of "Map full; can't update element"
     * -- a probe measuring nothing but its own overflow.
     */
    @n_dirtied = count();
}

kprobe:mmb_sync    { @syncs = count(); }

/*
 * What the filesystem says it did, as opposed to what the calls say.
 *
 * evict traces "evict sync" with the buffer count when the inode still
 * had links, and "evict drop" when it did not: the second is the list
 * being thrown away with whatever it held. write_inode traces its own.
 *
 * @n is what the list held when the call started, so an inode with
 * nothing to lose is told from one that lost four.
 */
/*
 * The node's own root is beamfs too.
 *
 * Without this filter the script counts the rootfs's evictions,
 * write_inodes and metadata buffers alongside the test's: a
 * generic/083 run reported 2447 evictions and 174960 dirtied buffers
 * with no way to tell which volume they belonged to, and the four
 * paths it separated were separated across both. Every other script
 * in this directory filters; this one did not.
 */
tracepoint:beamfs:beamfs_mmb
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    /*
     * args.how, not str(args.how).
     *
     * The field is __string(how, how), which the kernel emits as
     * __data_loc char[]: the record holds an offset and a length,
     * not a pointer. str() on it returned the empty string, so every
     * count landed under one nameless key -- @by_path[] 10139 and
     * @held[] over all paths at once, which is exactly the
     * distinction this script exists to make. bpftrace types a
     * __data_loc field as a string already.
     */
    @by_path[args.how] = count();
    @held[args.how] = hist(args.n);
    if (args.n > 0) {
        @nonempty[args.how] = count();
        @buffers[args.how] = sum(args.n);
    }
}
kprobe:mmb_invalidate
{
    /*
     * Counted, not stacked.
     *
     * A kstack(6) here walks six frames on every invalidate, and
     * mmb_invalidate is called once per eviction on a test that
     * evicts twenty thousand inodes. On 2026-09-19 the node stopped
     * answering ssh within its sixty-second budget while the script
     * attached, and the run was lost before the test began.
     *
     * The tracepoint below already says which path an inode left by
     * and how many buffers it held, which is the question.
     */
    @invalidates = count();
    @invalidate_by[comm] = count();
}

/* ENOSPC on the allocation path: what the tree looks like when the
 * volume runs out mid-construction. */
kretprobe:beamfs_alloc_block
/retval == 0/
{
    @alloc_failed = count();
}

kretprobe:beamfs_inline_lookup_or_alloc_phys_new
/(int64)retval == -28/
{
    @lookup_enospc = count();
    @enospc_stack[kstack(6)] = count();
}

kprobe:beamfs_evict_inode { @evictions = count(); }
kprobe:beamfs_write_inode { @write_inodes = count(); }

END { printf("\n"); }
