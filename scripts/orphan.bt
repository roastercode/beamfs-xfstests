#!/usr/bin/env bpftrace
/*
 * A block allocated and never placed in a tree.
 *
 * generic/476 ends with 867 blocks marked used, every one of them
 * 4096 zero bytes, in 37 runs -- and the kernel says nothing at all
 * about them. A block that is allocated, never written and never
 * referenced was never attached to an inode: alloc_block returned it
 * and no slot_store followed.
 *
 * Every legitimate allocation is followed by a slot_store for the same
 * block, within the same call, under i_alloc_mutex. So the map holds
 * what has been allocated and not yet placed, slot_store and
 * block_free take entries out, and whatever is left at the end is the
 * answer.
 *
 * Exhaustive rather than sampled: 867 out of tens of thousands is too
 * thin to sample, and the map stays small because almost everything
 * that goes in comes straight back out.
 */

BEGIN { printf("allocations that go nowhere\n"); }

tracepoint:beamfs:beamfs_block_alloc
{
    @allocs = count();
    @pending[args.blk] = args.ino;
    @where[args.blk] = kstack(6);
}

tracepoint:beamfs:beamfs_slot_store
{
    @placed = count();
    if (@pending[args.new]) {
        delete(@pending[args.new]);
        delete(@where[args.new]);
    }
}

tracepoint:beamfs:beamfs_block_free
{
    @frees = count();
    if (@pending[args.blk]) {
        delete(@pending[args.blk]);
        delete(@where[args.blk]);
    }
}

END
{
    printf("\nallocated, never placed, never freed:\n");
    print(@pending, 30);
    printf("\nand where they came from:\n");
    print(@where, 4);
}
