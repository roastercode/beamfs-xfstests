#!/usr/bin/env bpftrace
/*
 * A block allocated and never placed in a tree.
 *
 * Six of the eight failing tests leave blocks marked used that nothing
 * references, never written, each one on its own: generic/269's 220 in
 * 64 runs of one. fsck says where they are and whose neighbours they
 * have; it cannot say which path allocated them and walked away.
 *
 * Sampled, not exhaustive.
 *
 * A key per block filled bpftrace's map in seconds -- 65379 "Map full"
 * lines in a 21 MB capture, a probe measuring its own overflow. One
 * block in 512 is followed instead, which is plenty: the leak is
 * hundreds of blocks out of tens of thousands, so a sample of that
 * rate still catches several, and the stack is the same for all of
 * them or the finding is that it is not.
 */

BEGIN { printf("following one allocation in 512\n"); }

tracepoint:beamfs:beamfs_block_alloc
{
    @allocs = count();
    /* Cheap, deterministic, and spread across the volume. */
    if ((args.blk & 511) == 0) {
        @watched[args.blk] = args.ino;
        @stack[args.blk] = kstack(8);
        @followed = count();
    }
}

tracepoint:beamfs:beamfs_slot_store
{
    @placed = count();
    if ((args.new & 511) == 0) {
        delete(@watched[args.new]);
        delete(@stack[args.new]);
    }
}

tracepoint:beamfs:beamfs_block_free
{
    @frees = count();
    if ((args.blk & 511) == 0) {
        delete(@watched[args.blk]);
        delete(@stack[args.blk]);
    }
}

END
{
    printf("\nallocated, never placed, never freed:\n");
    print(@watched, 20);
    printf("\nwhere they came from:\n");
    print(@stack, 3);
}
