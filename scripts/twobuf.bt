#!/usr/bin/env bpftrace
/*
 * Two buffers for one block, or one buffer changing under a reader.
 *
 * treecheck says a slot held 18806 and was read as 0, in the same
 * function and for the same inode, with the write order forced -- so
 * the block was on the medium when the second read returned zero.
 * Something between the two is not what the first one wrote.
 *
 * Two shapes, and this tells them apart:
 *
 *   - two buffer_heads for the same block number, one holding what was
 *     written and the other what the medium held before it
 *   - one buffer_head whose contents changed, which means it was
 *     invalidated and re-read
 *
 * The first shows as two addresses for one block. The second as one
 * address appearing twice with a gap where nothing read it.
 */

BEGIN { printf("watching buffers for indirect blocks\n"); }

/*
 * Every buffer handed out for a block, by block number.
 *
 * @seen counts distinct addresses: bpftrace has no set, so the count
 * of a map keyed on (block, address) is the number of distinct pairs.
 */
/*
 * Only the indirection region, and only the address.
 *
 * Every buffer for every block filled 80 MB and answered a question
 * nobody asked. The blocks that matter sit just above data_start,
 * where indirect blocks are allocated first, and what matters about
 * them is how many distinct addresses one block saw -- not how many
 * times each was handed out.
 */
kretprobe:__bread_gfp
/retval != 0/
{
    $bh = (struct buffer_head *)retval;
    @reads = count();
    if ($bh->b_blocknr >= 18440 && $bh->b_blocknr < 18900) {
        @addrs[$bh->b_blocknr] = count();
        @seen[$bh->b_blocknr, (uint64)retval] = 1;
    }
}

/*
 * __getblk_gfp is not traceable -- inlined or notrace -- and the probe
 * that named it took the whole script down with it. bdev_getblk is the
 * caller it is reached through and it is traceable, which is close
 * enough: what matters is that a buffer was handed out for a block.
 */
kretprobe:bdev_getblk
/retval != 0/
{
    $bh = (struct buffer_head *)retval;
    @gets = count();
    if ($bh->b_blocknr >= 18440 && $bh->b_blocknr < 18900) {
        @addrs[$bh->b_blocknr] = count();
        @seen[$bh->b_blocknr, (uint64)retval] = 1;
    }
}

/* A buffer dropped: the next reader gets a fresh one. */
kprobe:invalidate_bh_lru { @invalidated = count(); }
kprobe:__brelse         { @released = count(); }

/*
 * And the moment treecheck catches it, so the capture can be lined up
 * against the block it names.
 */
kprobe:beamfs_tc_store
{
    @stores = count();
}

/*
 * The moment treecheck catches one, and what the block's buffers were.
 *
 * 80 MB of every buffer for every block answers a question nobody
 * asked. What matters is the handful of blocks a LOST POINTER names,
 * and those are known only when it fires -- so the map stays, and this
 * prints the entry for the block in question when it does.
 *
 * beamfs_tc_store's third argument is the parent block: the one whose
 * slot was read as zero.
 */
kprobe:beamfs_tc_store
/arg2 != 0/
{
    @watch[arg2] = count();
}

END
{
    printf("\ndistinct buffer addresses per indirect block:\n");
    print(@seen, 60);
    printf("\nparent blocks treecheck stored into:\n");
    print(@watch, 20);
}
