#!/usr/bin/env bpftrace
/*
 * A folio leaving the page cache with a reference nobody will drop.
 *
 * On 2026-09-21 the guest stalled with 6.6 GiB on the file LRU and
 * 114 MiB in any address_space: folios their file or device had
 * dropped, still held by someone, never freed. beamfs-xfstests
 * measures the pool as mem.orphan_file; a trial of generic/083 adds
 * about 196 MiB, pass or fail, and nothing ever gives it back.
 *
 * Every folio leaving the cache passes filemap_unaccount_folio, on
 * the single path and the batched one alike, and that fires
 * mm_filemap_delete_from_page_cache with the folio as first argument,
 * mapping and refcount intact. On 2026-09-22, from a freshly booted
 * node, two trials showed 282 939 and 294 669 removals, all but a
 * dozen at exactly two references, and 70-odd held folios in known
 * transient places. The pool does not form at the exit of the cache
 * through an extra reference.
 *
 * What that version declared normal is the finding. beamfs reads its
 * indirect blocks with sb_bread: buffer_heads in the block device's
 * page cache, and a folio with buffers attached carries one
 * reference for them. When the device is released,
 * blkdev_flush_mapping truncates that mapping; block_invalidate_folio
 * cannot free a buffer whose b_count is still positive, private
 * stays, and the folio leaves the cache anyway -- at three
 * references, batch, cache and buffers, which the previous version
 * expected. Batch and cache then let go, the buffer's reference does
 * not, and a folio out of the cache but never freed stays on the
 * LRU: file LRU above NR_FILE_PAGES, the pool exactly.
 *
 * So a folio leaving with private set is what is counted here, with
 * what the buffer_head says: its b_count, its block number, whether
 * the mapping is a block device. The block numbers name the blocks
 * whose buffer nobody released, and beamfs knows which of its paths
 * reads those.
 */

BEGIN { printf("watching folios leave the page cache\n"); }

rawtracepoint:mm_filemap_delete_from_page_cache
{
    $f = (struct folio *)arg0;
    $ref = $f->_refcount.counter;
    if ($ref == 0) {
        @reclaimed = count();
    } else {
        $priv = (uint64)$f->private;
        $host = $f->mapping->host;
        $bdev = (($host->i_mode & 0170000) == 0060000);
        @removed = count();
        @refs_on_removal = hist($ref);

        if ($priv != 0) {
            // Buffers still attached as the folio leaves: after
            // block_invalidate_folio tried to free them. A buffer
            // that survived that is a buffer someone still holds.
            $bh = (struct buffer_head *)$priv;
            @with_buffers[$bdev] = count();
            @bh_count = hist($bh->b_count.counter);
            if ($bdev) {
                @bdev_block_kept = hist($bh->b_blocknr);
                @bdev_blocks_kept[$bh->b_blocknr] = count();
            }
            @with_buffers_from[kstack(8)] = count();
        }

        $expect = 2;
        if ($priv != 0) {
            $expect = 3;
        }
        if ($ref > $expect) {
            @held = count();
            @excess = hist($ref - $expect);
            if ($bdev) {
                @held_bdev = count();
            } else {
                @held_file = count();
                @held_ino[$host->i_ino] = count();
            }
            @held_from[kstack(10)] = count();
        }
    }
}

END
{
    printf("\nblock-device blocks whose buffer was still held when the folio left:\n");
    print(@bdev_blocks_kept, 40);
    clear(@bdev_blocks_kept);
    printf("\nwho was removing folios that still carried buffers:\n");
    print(@with_buffers_from, 6);
    printf("\nfolios leaving the cache with an extra reference, by inode:\n");
    print(@held_ino, 10);
}
