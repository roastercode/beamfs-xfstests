#!/usr/bin/env bpftrace
/*
 * A folio leaving the page cache with a reference nobody will drop.
 *
 * On 2026-09-21 the guest stalled with 6.6 GiB on the file LRU and
 * 114 MiB in any address_space: folios their file or device had
 * dropped, still held by someone, never freed. beamfs-xfstests
 * measures the pool as mem.orphan_file; ten trials of generic/083 add
 * about 200 MiB each, pass or fail, and nothing ever gives it back.
 *
 * Two versions came before this one. The first sat on
 * __filemap_remove_folio and saw reclaim -- 286 896 removals per
 * trial at refcount 0, frozen by __remove_mapping, which cannot take
 * a held folio at all -- and thirteen held folios, shmem but one. It
 * could not see the batched path: truncate_inode_pages_range removes
 * folios through delete_from_page_cache_batch, which never calls
 * __filemap_remove_folio, and evicting an inode goes through it
 * entirely. The second sat on filemap_free_folio, which covers both,
 * and is inlined: bpftrace refused it.
 *
 * So both entrances, each on its own probe. delete_from_page_cache_batch
 * takes the batch while its folios are still in the mapping and after
 * truncate_cleanup_folio has detached whatever was private: two
 * references expected, the caller's and the cache's. The batch holds
 * at most 31 folios and bpftrace has no loop, so it is unrolled.
 * __filemap_remove_folio keeps the single path; a folio there at
 * refcount 0 is reclaim and is counted apart.
 *
 * A folio of order above zero carries one reference per page from
 * the cache; the histogram shows it as peaks at 1 + n rather than 1.
 */

BEGIN { printf("watching folios leave the page cache\n"); }

kprobe:delete_from_page_cache_batch
{
    $fb = (struct folio_batch *)arg1;
    $host = ((struct address_space *)arg0)->host;
    $n = (uint64)$fb->nr;
    @batches = count();
    @batch_size = hist($n);
    $i = (uint64)0;
    unroll(31) {
        if ($i < $n) {
            $f = $fb->folios[$i];
            $ref = $f->_refcount.counter;
            $priv = (uint64)$f->private;
            $expect = 2;
            if ($priv != 0) {
                $expect = 3;
            }
            @batched = count();
            @refs_in_batch = hist($ref);
            if ($ref > $expect) {
                @held = count();
                @held_batched = count();
                @excess = hist($ref - $expect);
                @held_with_private[$priv != 0] = count();
                if (($host->i_mode & 0170000) == 0060000) {
                    @held_bdev = count();
                } else {
                    @held_file = count();
                    @held_ino[$host->i_ino] = count();
                }
                @held_from[kstack(10)] = count();
            }
        }
        $i = $i + 1;
    }
}

kprobe:__filemap_remove_folio
{
    $f = (struct folio *)arg0;
    $ref = $f->_refcount.counter;
    if ($ref == 0) {
        @reclaimed = count();
    } else {
        $priv = (uint64)$f->private;
        $host = $f->mapping->host;
        $expect = 2;
        if ($priv != 0) {
            $expect = 3;
        }
        @single = count();
        @refs_single = hist($ref);
        if ($ref > $expect) {
            @held = count();
            @held_single = count();
            @excess = hist($ref - $expect);
            @held_with_private[$priv != 0] = count();
            if (($host->i_mode & 0170000) == 0060000) {
                @held_bdev = count();
            } else {
                @held_file = count();
                @held_ino[$host->i_ino] = count();
            }
            @held_from[kstack(10)] = count();
        }
    }
}

END
{
    printf("\nfolios leaving the cache while still held, by inode:\n");
    print(@held_ino, 20);
    printf("\nwho was removing them:\n");
    print(@held_from, 6);
}
