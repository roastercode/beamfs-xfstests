#!/usr/bin/env bpftrace
/*
 * A folio leaving its mapping with a reference nobody will drop.
 *
 * On 2026-09-21 the guest stalled with 6.6 GiB on the file LRU and
 * 114 MiB in any address_space: folios their file or device had
 * dropped, still held by someone, never freed. beamfs-xfstests
 * measures the pool as mem.orphan_file; ten trials of generic/083 add
 * about 200 MiB each, pass or fail, and nothing ever gives it back.
 *
 * The first version sat on __filemap_remove_folio and saw two things
 * it was not looking for. 286 896 removals per trial at refcount 0:
 * reclaim, which freezes the count before it removes, and which
 * cannot take a folio that holds an extra reference at all. And 13
 * with one reference too many, shmem but one. What it could not see
 * is the batched path: truncate_inode_pages_range removes folios
 * through delete_from_page_cache_batch, which never calls
 * __filemap_remove_folio, and evicting an inode goes through it
 * entirely. That is the path an unlink storm takes.
 *
 * filemap_free_folio is called for every folio deleted from the
 * cache, batched or not, before the cache gives its references back.
 * At its entry a folio of order zero holds the caller's reference
 * and the cache's, plus one if something is attached as private;
 * anything above that will outlive the mapping. This records whose
 * folio it was, whether private was still attached, and who was
 * deleting it.
 *
 * A folio of order above zero carries one reference per page from
 * the cache; the histogram shows it as peaks at 1 + n rather than 1.
 */

BEGIN { printf("watching folios leave the page cache\n"); }

kprobe:filemap_free_folio
{
    $f = (struct folio *)arg1;
    $host = ((struct address_space *)arg0)->host;
    $ref = $f->_refcount.counter;
    $priv = (uint64)$f->private;
    $expect = 2;
    if ($priv != 0) {
        $expect = 3;
    }
    @freed = count();
    @refs_at_free = hist($ref);
    if ($ref > $expect) {
        @held = count();
        @excess = hist($ref - $expect);
        @held_with_private[$priv != 0] = count();
        if (($host->i_mode & 0170000) == 0060000) {
            @held_bdev = count();
        } else {
            @held_file = count();
            @held_ino[$host->i_ino] = count();
        }
        @held_from[kstack(10)] = count();
    }
}

kprobe:delete_from_page_cache_batch { @batches = count(); }
kprobe:__remove_mapping { @reclaimed = count(); }

END
{
    printf("\nfolios deleted from the cache while still held, by inode:\n");
    print(@held_ino, 20);
    printf("\nwho was deleting them:\n");
    print(@held_from, 6);
}
