#!/usr/bin/env bpftrace
/*
 * Did the parity of an indirect block reach the medium -- and what did
 * the region block hold on its way there?
 *
 * generic/476 on 2026-09-23, module 0.1.10 then 0.1.11 on 7.3-rc4: the
 * test passed, the volume unmounted cleanly, and fsck found 102, then
 * 112 indirect blocks holding pointers under a parity slot still zero.
 * The first version of this script showed, for every one of them, an
 * update with exactly the pointer count fsck read, followed by a write
 * of the region block; 46 of the 112 were the only indirect block of
 * their region ever updated, and their region was written exactly
 * once, after the last update, carrying a zero slot. So between the
 * update, done in the buffer under its lock, and the write, the
 * buffer's bytes changed. This version reads those bytes.
 *
 * Three views of every region block of the test and scratch devices:
 *   - at mark_buffer_dirty, right after an update: which of the
 *     14 slots are non-zero in b_data (the first 8 bytes of each);
 *   - at submit_bio of a write: the same mask, read from the page the
 *     bio carries (page address from vmemmap_base/page_offset_base);
 *   - every read of the block from the device: one is the first use,
 *     a second one is a reload over whatever memory held.
 * Plus the per-indirect-block record the first version kept.
 *
 * The slot masks are not a witness any more: on 2026-09-24 the module
 * read its slot back from b_data at the same instants, 802 816 times,
 * and never missed it, while this script reported it absent for 30% of
 * updates. The timestamps of writes and reads stand; 2.3.33 cleared
 * @region_read_ns at END by mistake, 2.3.34 keeps it.
 *
 * The region zone is that of the 1 GiB volume mkfs.beamfs -N 16384
 * lays out: blocks 1033 to 18442. Slot k of a region sits at payload
 * offset k*256, and the payload is interleaved with parity, 239 bytes
 * every 255: each 8-byte word of a slot is mapped through raw =
 * (off/239)*255 + off%239 on its own, since a slot straddles a
 * subblock boundary, and all 256 bytes are tested -- the first 8 are
 * the parity of the first 29 pointers alone, zero for a sparse file.
 * Loops rather than unrolling: 14 x 32 unrolled words overflowed the
 * 512-byte BPF stack on 2026-09-23 and the probe never attached.
 */

BEGIN { printf("watching indirect parity updates, region dirtying, region writes and reads\n"); }

tracepoint:beamfs:beamfs_parity_slot
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @updates = count();
    @upd_ns[args.phys]     = nsecs;
    @upd_region[args.phys] = args.region;
    @upd_ptrs[args.phys]   = args.nz;
    @upd_ino[args.phys]    = args.ino;
    @upd_count[args.phys]  = count();
}

/*
 * The buffer the update just modified, as it is marked dirty.
 * mark_buffer_dirty is the exported function every dirtying goes
 * through, the per-inode metadata list helper included; the mmb_*
 * helper itself may be inlined and carry no symbol to attach to.
 */
kprobe:mark_buffer_dirty
{
    $bh  = (struct buffer_head *)arg0;
    $dev = $bh->b_bdev->bd_dev;
    $blk = $bh->b_blocknr;

    if (($dev == BX_TEST_DEV || $dev == BX_SCRATCH_DEV) && $blk >= 1033 && $blk < 18443) {
        $d = (uint8 *)$bh->b_data;
        $m = (uint64)0;
        $k = (uint64)0;
        while ($k < 14) {
            $nz = (uint64)0;
            $j = (uint64)0;
            while ($j < 32) {
                $off = $k * 256 + $j * 8;
                $r = $off % 239;
                $raw = ($off / 239) * 255 + $r;
                if ($r <= 231) {
                    $nz = $nz | *(uint64 *)($d + $raw);
                } else {
                    $n1 = 239 - $r;
                    $nz = $nz | (*(uint64 *)($d + $raw) & (((uint64)1 << (8 * $n1)) - 1));
                    $nz = $nz | (*(uint64 *)($d + $raw + $n1 + 16) & (((uint64)1 << (8 * (8 - $n1))) - 1));
                }
                $j = $j + 1;
            }
            if ($nz != 0) {
                $m = $m | ((uint64)1 << $k);
            }
            $k = $k + 1;
        }
        @dirtied = count();
        @dirtied_by_stack[kstack(6)] = count();
        @memmask[$blk]    = $m;
        @memmask_ns[$blk] = nsecs;
        @memstate[$blk]   = $bh->b_state;
    }
}

kprobe:submit_bio
{
    $bio = (struct bio *)arg0;
    $dev = $bio->bi_bdev->bd_dev;

    if ($dev == BX_TEST_DEV || $dev == BX_SCRATCH_DEV) {
        $op    = $bio->bi_opf & 0xff;
        $bytes = $bio->bi_iter.bi_size;
        $blk   = $bio->bi_iter.bi_sector / 8;

        if ($blk >= 1033 && $blk < 18443) {
            if ($op == 1) {
                @region_writes = count();
                @region_write_size = hist($bytes);
                @landed_ns[$blk] = nsecs;
                @landed_count[$blk] = count();
                @region_writes_by_stack[kstack(8)] = count();
                if ($bytes > 4096) {
                    @region_multi = count();
                }

                /* The bytes this bio carries, read from its first page. */
                $bv   = $bio->bi_io_vec;
                $pg   = (uint64)$bv->bv_page;
                $vm   = *(uint64 *)kaddr("vmemmap_base");
                $po   = *(uint64 *)kaddr("page_offset_base");
                $virt = (($pg - $vm) / 64) * 4096 + $po + (uint64)$bv->bv_offset;
                $d    = (uint8 *)$virt;
                $m = (uint64)0;
                $k = (uint64)0;
                while ($k < 14) {
                    $nz = (uint64)0;
                    $j = (uint64)0;
                    while ($j < 32) {
                        $off = $k * 256 + $j * 8;
                        $r = $off % 239;
                        $raw = ($off / 239) * 255 + $r;
                        if ($r <= 231) {
                            $nz = $nz | *(uint64 *)($d + $raw);
                        } else {
                            $n1 = 239 - $r;
                            $nz = $nz | (*(uint64 *)($d + $raw) & (((uint64)1 << (8 * $n1)) - 1));
                            $nz = $nz | (*(uint64 *)($d + $raw + $n1 + 16) & (((uint64)1 << (8 * (8 - $n1))) - 1));
                        }
                        $j = $j + 1;
                    }
                    if ($nz != 0) {
                        $m = $m | ((uint64)1 << $k);
                    }
                    $k = $k + 1;
                }
                @wrmask[$blk] = $m;
                @wrmask_ns[$blk] = nsecs;
            }
            if ($op == 0) {
                @region_reads = count();
                @region_read_count[$blk] = count();
                @region_read_ns[$blk] = nsecs;
                @region_reads_by_stack[kstack(8)] = count();
            }
        }
    }
}

tracepoint:beamfs:beamfs_block_free
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @frees = count();
    if (@upd_ns[args.blk] != 0) {
        @freed_after_update[args.blk] = nsecs;
    }
}

END {
    /*
     * The decisive maps first, by hand: bpftrace prints the rest in
     * alphabetical order afterwards, and on 2026-09-23 the harness
     * killed it three seconds into that listing -- @upd_region and
     * @wrmask, the ones the question is about, were the ones cut.
     * The bulky maps nothing reads are cleared so the listing is short.
     */
    print(@upd_region);
    print(@upd_ptrs);
    print(@wrmask);
    print(@wrmask_ns);
    print(@memmask);
    print(@memmask_ns);
    print(@region_read_count);
    clear(@upd_ino);
    clear(@upd_count);
    clear(@memstate);
    clear(@landed_count);
    clear(@freed_after_update);
    printf("\n");
}
