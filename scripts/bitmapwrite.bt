#!/usr/bin/env bpftrace
/*
 * Does every change to the bitmap reach the block that carries it?
 *
 * generic/013 allocates 51528 blocks and frees 51528 on the volumes
 * under test, so the bitmap in memory is right, and fsck still reports
 * blocks marked used that nothing references -- one of them with 0 of
 * 4096 bytes set, allocated and never written. The change is made and
 * the medium does not have it.
 *
 * beamfs_write_bitmap_block is the one path from a changed bit to the
 * block that holds it. It is called once per allocation and once per
 * free, so its count should equal allocs + frees. It also decides
 * whether the buffer joins an inode's metadata list: owner is NULL on
 * the free path from beamfs_free_data_blocks, and skipped when the
 * owner is already I_FREEING, and in both cases nothing marks an inode
 * to carry it.
 *
 * BX_TEST_DEV and BX_SCRATCH_DEV are replaced by beamfs-xfstests.
 */

BEGIN { printf("bitmap writes, by path\n"); }

tracepoint:beamfs:beamfs_block_alloc
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @allocs[args.dev] = count();
}

tracepoint:beamfs:beamfs_block_free
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @frees[args.dev] = count();
}

/*
 * arg0 is the superblock, arg2 the owning inode or NULL.
 *
 * I_FREEING is (1U << 8) in include/linux/fs.h, read there rather
 * than remembered: 0x10 was wrong by a factor of sixteen and would
 * have matched I_DIRTY_SYNC instead. i_state is a struct in 7.3,
 * not an integer, so the flags live in i_state.__state. An owner in
 * that state
 * takes the same path as no owner at all: the buffer is dirtied and
 * attached to nothing.
 */
kprobe:beamfs_write_bitmap_block
/((struct super_block *)arg0)->s_dev == BX_TEST_DEV ||
 ((struct super_block *)arg0)->s_dev == BX_SCRATCH_DEV/
{
    $dev = ((struct super_block *)arg0)->s_dev;
    @wbb[$dev] = count();
    if (arg2 == 0) {
        @wbb_no_owner[$dev] = count();
    } else {
        if (((struct inode *)arg2)->i_state.__state & 0x0100) {
            @wbb_owner_freeing[$dev] = count();
        } else {
            @wbb_attached[$dev] = count();
        }
    }
}

/*
 * What the two flush paths found and wrote.
 *
 * beamfs_free_data_blocks, beamfs_put_super and beamfs_sync_fs are
 * static and inlined, so kprobe cannot attach to them; the kernel
 * carries a tracepoint instead. This is where a free that was never
 * attached to an inode has its last chance of reaching the medium.
 */
tracepoint:beamfs:beamfs_bitmap_flush
/args.dev == BX_TEST_DEV || args.dev == BX_SCRATCH_DEV/
{
    @flush[args.dev, str(args.where)] = count();
    @flush_dirty[args.dev, str(args.where)] = sum(args.dirty);
    @flush_written[args.dev, str(args.where)] = sum(args.written);
    if (args.err != 0) {
        @flush_err[args.dev, str(args.where)] = count();
    }
}


END
{
    printf("\nper volume: allocs + frees should equal wbb\n");
    printf("a free that reaches no inode reaches the medium only here\n");
}
